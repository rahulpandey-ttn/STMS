<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="STMS App Shell"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <ticketsListPage
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="Page containing the Ticket List component."
                        fieldLabel="Tickets List Page"
                        name="./ticketsListPage"
                        rootPath="/content/stms"/>
                    <createTicketPage
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="Page containing the Create Ticket component."
                        fieldLabel="Create Ticket Page"
                        name="./createTicketPage"
                        rootPath="/content/stms"/>
                    <brandTitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Brand Title"
                        name="./brandTitle"
                        value="STMS"/>
                    <brandSubtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Brand Subtitle"
                        name="./brandSubtitle"
                        value="Support Ticket System"/>
                    <userDisplayName
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Optional display name override for the sidebar user profile."
                        fieldLabel="User Display Name"
                        name="./userDisplayName"/>
                    <userRole
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="User Role"
                        name="./userRole"
                        value="Support agent"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
