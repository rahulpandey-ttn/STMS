<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Ticket Detail"
        cq:template="/conf/stms/settings/wcm/templates/page-content"
        sling:resourceType="stms/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="stms/components/appshell"
            layout="simple"
            ticketsListPage="/content/stms/us/en/tickets"
            createTicketPage="/content/stms/us/en/tickets/create-ticket">
            <ticketdetail
                jcr:primaryType="nt:unstructured"
                sling:resourceType="stms/components/ticketdetail"
                listPage="/content/stms/us/en/tickets"
                editPage="/content/stms/us/en/tickets/edit-ticket"/>
            <ticketcomments
                jcr:primaryType="nt:unstructured"
                sling:resourceType="stms/components/ticketcomments"
                detailPage="/content/stms/us/en/ticket-detail"/>
        </root>
    </jcr:content>
</jcr:root>
