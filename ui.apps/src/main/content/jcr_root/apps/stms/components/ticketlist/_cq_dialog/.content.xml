<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Ticket List"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <limit
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                        fieldDescription="Maximum number of tickets to display. Leave empty for no limit."
                        fieldLabel="Result Limit"
                        min="{Long}1"
                        name="./limit"/>
                    <detailPage
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="Page containing the Ticket Detail component. Used for ticket links."
                        fieldLabel="Ticket Detail Page"
                        name="./detailPage"
                        rootPath="/content/stms"/>
                    <createPage
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldDescription="Page containing the Create Ticket component. Used for the Create Ticket button."
                        fieldLabel="Create Ticket Page"
                        name="./createPage"
                        rootPath="/content/stms"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
